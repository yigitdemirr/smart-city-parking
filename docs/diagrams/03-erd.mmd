%% Entity-relationship diagram (PostgreSQL) - matches database/schema.sql
erDiagram
    USERS ||--o{ OPERATIONS : "issues"
    OPERATIONS ||--o| RESERVATIONS : "creates"
    OPERATIONS ||--o| PAYMENTS : "creates"
    USERS ||--o{ RESERVATIONS : "makes"
    RESERVATIONS ||--o{ PAYMENTS : "is paid by"
    PARKING_SPACES ||--o{ RESERVATIONS : "is booked by"
    PARKING_FACILITIES ||--|{ PARKING_SPACES : "contains"

    USERS {
        uuid id PK
        varchar email UK "unique, case-insensitive"
        varchar password_hash
        varchar display_name
        varchar role "DRIVER | ADMIN"
        timestamptz created_at
    }
    PARKING_FACILITIES {
        uuid id PK
        varchar name
        varchar address
        numeric latitude "9,6 WGS-84"
        numeric longitude "9,6 WGS-84"
        varchar data_source "ADMIN_ENTRY | SEED_SIMULATED"
        boolean is_active
        timestamptz updated_at
    }
    PARKING_SPACES {
        uuid id PK
        uuid facility_id FK
        varchar label "unique per facility"
        varchar space_type "STANDARD | DISABLED | EV"
        numeric price_per_hour "8,2 PLN"
        boolean is_active
        int version "optimistic lock"
    }
    RESERVATIONS {
        uuid id PK
        uuid user_id FK
        uuid space_id FK
        uuid operation_id FK,UK
        varchar status "HELD | CONFIRMED | EXPIRED | CANCELLED | COMPLETED"
        timestamptz start_time
        timestamptz end_time
        tstzrange period "no overlap per space (EXCLUDE)"
        timestamptz hold_expires_at
        numeric total_amount "10,2"
        int version
    }
    PAYMENTS {
        uuid id PK
        uuid reservation_id FK
        uuid operation_id FK,UK
        numeric amount "10,2"
        char currency "PLN"
        varchar status "SUCCEEDED | DECLINED"
        boolean is_simulated "always TRUE"
        timestamptz created_at
    }
    OPERATIONS {
        uuid operation_id PK "generated by client"
        uuid user_id FK
        varchar operation_type
        char request_hash "SHA-256"
        varchar outcome "SUCCEEDED | REJECTED"
        smallint http_status
        jsonb response_body "replayed on retry"
        uuid resource_id
        timestamptz created_at
    }
